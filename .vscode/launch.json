{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}" // Set this to your project root
      }
    },
    {
      "name": "Python: pytest",
      "type": "python",
      "request": "launch",
      "module": "pytest", // Run pytest as a module
      "args": [
        "tests" // Specify the tests folder or a specific test file
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Debug test_model.py",
      "type": "python",
      "request": "launch",
      "module": "pytest", // Run pytest as a module
      "args": [
        "tests/test_models.py" // Specify the path to your test file
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}" // Ensure your project root is in PYTHONPATH
      }
    },
    {
      "name": "Python: Debug test_agent.py",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_agent.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Run Server",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Debug test_search_agent.py",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_search_agent.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
  ]
}
